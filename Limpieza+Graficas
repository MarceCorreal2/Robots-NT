        "\n",
        "# Plot Equity Curve\n",
        "ax1.step(\n",
        "    df['Entry time'],\n",
        "    df['Cum. net profit'],\n",
        "    where='post',\n",
        "    color='navy',\n",
        "    linewidth=4\n",
        ")\n",
        "ax1.set_title('Equity Curve')\n",
        "ax1.set_ylabel('Cumulative Net Profit')\n",
        "ax1.grid(alpha=0.3)\n",
        "\n",
        "# Plot Drawdown\n",
        "ax2.fill_between(\n",
